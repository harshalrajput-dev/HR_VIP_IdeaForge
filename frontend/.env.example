# ---------------------------------------------------------------------------
# HR VIP IdeaForge - frontend environment variables
# Copy to `.env` (or `.env.local`) and adjust for your environment.
# ---------------------------------------------------------------------------

# Base URL of the Express API, including the /api prefix.
# Local dev only. In production (Vercel) leave this UNSET so the client uses the
# relative `/api` path and vercel.json proxies it to the backend function.
VITE_API_BASE_URL=http://localhost:5000/api

# Legacy alias still honoured by src/services/api.js (lower priority than the
# VITE_API_BASE_URL above). VITE_API_URL=http://localhost:5000/api

# Optional: shown in the navbar footer ("API: connected / offline")
VITE_APP_NAME=HR VIP IdeaForge
