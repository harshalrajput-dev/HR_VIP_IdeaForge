# ---------------------------------------------------------------------------
# HR VIP IdeaForge - backend environment variables
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# MongoDB
# Local:  mongodb://127.0.0.1:27017/hr_vip_ideaforge
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/hr_vip_ideaforge?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/hr_vip_ideaforge

# Explicit database name the API reads/writes (ideas, users, comments, projects).
# Optional: when unset, the database in MONGO_URI is used, falling back to
# `hr_vip_ideaforge`. Set it on Vercel if your Atlas URI omits the path segment.
MONGO_DB_NAME=hr_vip_ideaforge

# Auth - MUST be replaced with a long random string in production
# generate one with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_64_char_random_secret_before_going_to_production
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Comma separated list of browser origins allowed to call the API.
# Use `*` to allow every origin (default when unset).
CORS_ORIGIN=*

# Demo data: seed the database automatically on the first request when it is
# empty (handy on serverless/Vercel). Set to `false` to disable.
AUTO_SEED=true

# Protects the /api/seed endpoint. When set, callers must pass the value via the
# `x-seed-secret` header or `?secret=` query param.
# SEED_SECRET=replace_with_a_random_secret

# Comma separated emails that are auto-promoted to the `hr_vip_employee` role on sign-up
BOOTSTRAP_ADMIN_EMAILS=hr.vip.admin@company.com

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=25

# Pagination
DEFAULT_PAGE_SIZE=12
MAX_PAGE_SIZE=50

# Client IP trust (set to 1 when deployed behind a single reverse proxy / load balancer)
TRUST_PROXY_HOPS=0
