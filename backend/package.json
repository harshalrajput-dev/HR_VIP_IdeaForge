{
  "name": "hr-vip-ideaforge-backend",
  "version": "1.0.0",
  "private": true,
  "description": "HR VIP IdeaForge REST API - Express + MongoDB + JWT",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "seed:fresh": "node scripts/seed.js --fresh",
    "test": "node scripts/smoke.js",
    "test:contract": "node scripts/contract-check.mjs",
    "test:suggestions": "node scripts/verify-suggestions.js",
    "test:ui": "node scripts/verify-new-ui.mjs",
